# Copy to .env and fill in. Never commit .env.
# The domain the game connects to (its DNS must point at this server).
DOMAIN=play.example.com
# Long random strings: `openssl rand -hex 24` for each.
DB_PASSWORD=
# SERVER_KEY also goes into the game (src/net/net_config.gd). It is not a
# secret from players, it only keeps random bots off; the others are secret.
SERVER_KEY=
HTTP_KEY=
SESSION_KEY=
REFRESH_KEY=
CONSOLE_SIGNING_KEY=
CONSOLE_PASSWORD=
