extends Node
## Bakes src/data/prop_footprints.gd: for every model the arenas place, the XZ
## rectangle (model space, scale 1) of the geometry between BAND_LO and BAND_HI
## metres up: the part a walker's body meets. Steps, floor slabs and tree
## canopies fall outside the band, so a tree blocks at its trunk and a crypt at
## its walls, not its doorstep.
##   tools/dev/godot.sh res://tools/dev/bake_prop_footprints.tscn
## The test "prop footprints baked" fails when a model changes and this is stale.

const PS := preload("res://src/hunt/prop_shapes.gd")
const OUT := "res://src/data/prop_footprints.gd"


func _ready() -> void:
	var names: Array = PS.POLICY.keys()
	names.sort()
	var lines := PackedStringArray()
	lines.append("extends RefCounted")
	lines.append("## Generated by tools/dev/bake_prop_footprints.gd; do not edit by hand.")
	lines.append("## model file -> [centre x, centre z, half x, half z] at scale 1, in model space,")
	lines.append("## of the geometry %.2f-%.2f m above the ground (see prop_shapes.gd)." % [PS.BAND_LO, PS.BAND_HI])
	lines.append("")
	lines.append("const FOOT := {")
	for n: String in names:
		if PS.POLICY[n] == "walk":
			continue
		var f: Array = PS.measure(PS.path_of(n))
		print("FOOT ", n, " ", f)
		lines.append("\t\"%s\": [%.3f, %.3f, %.3f, %.3f]," % [n, f[0], f[1], f[2], f[3]])
	lines.append("}")
	var fa := FileAccess.open(OUT, FileAccess.WRITE)
	fa.store_string("\n".join(lines) + "\n")
	fa.close()
	print("BAKED %d footprints" % (lines.size() - 7))
	get_tree().quit()
