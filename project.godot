; Engine configuration file.
; Godot 4.7 — Critter Clash

config_version=5

[application]

config/name="Critter Clash"
config/description="A portrait glade where matching critters merge into a habitat evolution."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.98, 0.8, 0.64, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

AudioDirector="*res://scripts/audio_director.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.ios="metal"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=2
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.965, 0.78, 0.64, 1)
