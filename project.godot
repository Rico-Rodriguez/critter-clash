; Engine configuration file.
; Godot 4.7 — Barrowfall (repo: critter-clash)

config_version=5

[application]

config/name="Barrowfall"
config/description="A portrait dark-fantasy hunt. Rise through the Barrow, break the dead, take their loot."
config/version="2.0.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.03, 0.03, 0.05, 1)
boot_splash/show_image=false
config/icon="res://assets/icon.png"

[autoload]

Ota="*res://src/autoload/ota_boot.gd"
Game="*res://src/autoload/game.gd"
Sfx="*res://src/autoload/sfx.gd"

[ota]

build=0
sha=""

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1
window/ios/allow_high_refresh_rate=true

[gui]

theme/custom="res://src/ui/theme.tres"
common/snap_controls_to_pixels=true

