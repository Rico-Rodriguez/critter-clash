[sub_resource type="Shader" id="Shader_hurt"]
code = "shader_type canvas_item;
uniform float strength = 0.0;
uniform vec4 color : source_color = vec4(0.62, 0.02, 0.02, 1.0);
void fragment() {
	vec2 uv = UV - vec2(0.5);
	float d = length(uv * vec2(1.0, 0.75));
	float v = smoothstep(0.28, 0.72, d);
	COLOR = vec4(color.rgb, v * strength * 0.85);
}
"

[sub_resource type="ShaderMaterial" id="Mat_hurt"]
shader = SubResource("Shader_hurt")
shader_parameter/strength = 0.0

