# Binary art and audio go through Git LFS.
*.glb filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.res filter=lfs diff=lfs merge=lfs -text
# Godot text formats stay diffable.
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.gdshader text eol=lf
*.import text eol=lf

# The Iron & Ember fonts are small and live in git itself (LFS uploads are
# refused from the cloud sessions that added them).
assets/fonts/Barlow*.ttf -filter -diff -merge binary
assets/fonts/CormorantSC-Bold.ttf -filter -diff -merge binary
assets/fonts/GravelightCaps-Bold.ttf -filter -diff -merge binary
# Pets made in Blender (tools/blender/pets): small, and kept out of LFS for the same reason.
assets/sidekicks/dragon_src.glb -filter -diff -merge binary
assets/sidekicks/dragon_src_dragon_tex.png -filter -diff -merge binary
assets/sidekicks/dragon_ash_*.png -filter -diff -merge binary
assets/sidekicks/mawko_src.glb -filter -diff -merge binary
assets/sidekicks/mawko_src_mawko_tex.png -filter -diff -merge binary
